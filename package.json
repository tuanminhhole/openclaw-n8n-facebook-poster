{
  "name": "openclaw-n8n-facebook-poster",
  "version": "3.0.0",
  "description": "Send Facebook posts to N8N webhook with drafting support",
  "main": "index.js",
  "author": "tuanminhhole",
  "type": "module",
  "exports": "./index.js",
  "sideEffects": false,
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "package.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24",
      "minGatewayVersion": "2026.3.24"
    },
    "build": {
      "entry": "./index.js",
      "openclawVersion": "2026.3.24",
      "pluginSdkVersion": "2026.3.24"
    }
  },
  "peerDependencies": {
    "openclaw": "*"
  }
}
